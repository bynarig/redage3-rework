{
  "name": "redage-v3",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --parallel build",
    "build:cef": "pnpm --filter svelte-app build",
    "build:cef-new": "pnpm --filter vue-project build",
    "build:client": "pnpm --filter client-side build",
    "build:client-new": "pnpm --filter client-side-new build",
    "dev:cef": "pnpm --filter svelte-app dev",
    "dev:cef-new": "pnpm --filter vue-project dev",
    "dev:client-new": "pnpm --filter client-side-new dev",
    "type-check": "pnpm -r --parallel --if-present type-check",
    "lint": "pnpm -r --parallel --if-present lint",
    "test": "pnpm -r --parallel --if-present test:unit",
    "prisma:update-models": "prisma db execute --config ./database/prisma.config.ts --file ./database/main_drop.sql && prisma db execute --config ./database/prisma.config.ts --file ./database/main_rework.sql && prisma db pull --schema=./database/prisma/schema.prisma --config ./database/prisma.config.ts --force && pnpm run prisma:generate",
    "prisma:generate": "prisma generate --schema=./database/prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^7.8.0"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  },
  "workspaces": [
    "src_cef",
    "src_cef_new",
    "src_client",
    "src_client_new"
  ]
}
