<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>8</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Copy native Grpc.Core binaries alongside the DLL so RAGE:MP can load them -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- C-core gRPC server — self-contained, no Kestrel/ASP.NET Core needed -->
    <PackageReference Include="Grpc.Core" Version="2.46.6" />
    <PackageReference Include="gtanetwork.api" Version="1.1.0-DP1-2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bootstrapper.dll ships with RAGE:MP; adjust path if needed -->
    <Reference Include="Bootstrapper">
      <HintPath>..\..\resources\NeptuneEvo\Bootstrapper.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
