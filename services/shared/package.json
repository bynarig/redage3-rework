{
  "name": "@redage/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prisma": {
      "types": "./prisma/index.d.ts",
      "import": "./prisma/index.js",
      "require": "./prisma/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "prisma generate --schema=../../database/prisma/schema.prisma",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prisma": "^7.8.0",
    "typescript": "^5.6.3"
  },
  "files": ["dist", "prisma"]
}
