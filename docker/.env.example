# Copy to docker/.env and run prod compose commands with `--env-file docker/.env`.
# The dev compose hard-codes its own values; only prod reads this file.

POSTGRES_DB=redage3
POSTGRES_USER=bynarig
POSTGRES_PASSWORD=bynarig
POSTGRES_HOST_PORT=5433

# What hostname the host machine (and RAGE:MP) uses to reach Kafka.
# In single-host deployments this is `localhost`. Multi-host: the broker's FQDN.
KAFKA_HOST=localhost
KAFKA_HOST_PORT=9092

LOG_LEVEL=info

# RAGE:MP game-client ports (UDP+TCP). 22005 is the default.
RAGEMP_PORT=22005
RAGEMP_HTTP_PORT=22006

# Service replica counts.
AUTH_REPLICAS=1
PLAYER_REPLICAS=1
