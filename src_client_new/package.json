  },
  "devDependencies": {
    "@ragempcommunity/types-client": "^2.1.9",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.6.0",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.4"
  }
