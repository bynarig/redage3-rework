{
  "name": "redage4-client",
  "version": "0.0.1-alpha",
  "description": "RAGE MP client-side scripts (TypeScript)",
  "type": "commonjs",
  "scripts": {
    "build": "webpack-cli --config ./webpack.config.js --mode=production",
    "dev": "webpack-cli --config ./webpack.config.js --mode=development --watch",
    "lint": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/client": "^7.8.0",
    "rage-rpc": "^0.4.0",
    "typescript-eslint": "^8.59.1"
  },
  "devDependencies": {
    "@ragempcommunity/types-client": "^2.1.9",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "ts-loader": "^9.5.0",
    "ts-mockito": "^2.6.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.4"
  }
}
