  name            String     @db.VarChar(50)
  account         String     @db.VarChar(50)
  time            DateTime   @db.Timestamp(6)
  until           DateTime   @db.Timestamp(6)
  is_hard_ban     Boolean?   @default(false)
  ip              String?    @db.VarChar(255)
  social_club     String?    @db.VarChar(255)
  hwid            String?    @db.VarChar(256)
  reason          String?    @db.VarChar(300)
  by_admin        String?    @db.VarChar(50)
  rgsc_email_hash String?    @default("-") @db.VarChar(128)
  characters      characters @relation(fields: [uuid], references: [uuid], onDelete: NoAction, onUpdate: NoAction)
}

model battlepass {
  uuid              Int        @id
