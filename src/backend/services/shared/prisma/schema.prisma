  bind4      String     @default("0") @db.VarChar(20)
  bind5      String     @default("0") @db.VarChar(20)
  bind6      String     @default("0") @db.VarChar(20)
  bind7      String     @default("0") @db.VarChar(20)
  bind8      String     @default("0") @db.VarChar(20)
  bind9      String     @default("0") @db.VarChar(20)
  bind10     String     @default("0") @db.VarChar(20)
  characters characters @relation(fields: [uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction)
}

model character_bind_cfg {
  uuid          Int        @id
  bindsetting   String     @default("{}") @db.VarChar(800)
