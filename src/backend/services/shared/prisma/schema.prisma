  lastname                                      String?                   @db.VarChar(50)
  gender                                        character_gender?         @default(MALE)
  health                                        Int?                      @default(100)
  armor                                         Int?                      @default(0)
  lvl                                           Int?                      @default(1)
  exp                                           Int?                      @default(0)
  money                                         Int?                      @default(0)
  bank                                          Int?
  work                                          Int?
  fraction                                      Int?
  fraction_lvl                                  Int?
  drug_addicted                                 Boolean?                  @default(false)
  arrest                                        Int?
  demorgan                                      Int?
  wanted                                        String?                   @db.VarChar(512)
  biz                                           String?                   @db.VarChar(50)
  licenses                                      String?                   @db.VarChar(256)
  unwarn                                        DateTime?                 @db.Timestamp(6)
  unmute                                        Int?                      @default(0)
  warns                                         Int?
  on_duty                                       String?                   @default("") @db.VarChar(50)
  last_hour                                     Int?
  hotel                                         Int?
  hotel_left                                    Int?
  contacts                                      String?                   @db.VarChar(2500)
  achiev                                        String?                   @db.VarChar(2450)
  sim_card                                      Int?                      @unique
  petname                                       String                    @db.VarChar(30)
  pos                                           String?                   @db.VarChar(256)
  create_date                                   DateTime?                 @db.Timestamp(6)
  demorgan_info                                 String?                   @default("{Admin:-1,Reason:-1}") @db.VarChar(350)
  warn_info                                     String?                   @default("{Admin:[-1,-1,-1],Reason:[-1,-1,-1]}") @db.VarChar(1000)
  time                                          String?                   @default("{TotalTime:0,Day:16,TodayTime:0,Month:3,MonthTime:0,Year:2020,YearTime:0,Week:1,WeekTime:0}") @db.VarChar(250)
  deaths                                        BigInt?                   @default(0)
  kills                                         BigInt?                   @default(0)
  earned_money                                  BigInt?                   @default(0)
  eat_times                                     BigInt?                   @default(0)
  revived                                       BigInt?                   @default(0)
  hands_shaken                                  BigInt?                   @default(0)
  refcode                                       String?                   @db.VarChar(64)
  wedding_uuid                                  Int?
  weddingname                                   String                    @default("") @db.VarChar(50)
  missiontask                                   String                    @default("{}")
  isbannedmp                                    Int                       @default(0) @db.SmallInt
  banmpreason                                   String                    @default("") @db.VarChar(64)
  isbannedcrime                                 Int                       @default(0) @db.SmallInt
  bancrimereason                                String                    @default("") @db.VarChar(64)
  selectedquest                                 String                    @db.VarChar(42)
  isforbesshow                                  Int                       @default(0) @db.SmallInt
  fractiontasksdata                             String                    @default("[]") @db.VarChar(350)
  islucky                                       Int                       @default(0) @db.SmallInt
  admins                                        admins?
  advertises_advertises_author_simTocharacters  advertises[]              @relation("advertises_author_simTocharacters")
  advertises_advertises_author_uuidTocharacters advertises[]              @relation("advertises_author_uuidTocharacters")
  advertises_advertises_editor_uuidTocharacters advertises[]              @relation("advertises_editor_uuidTocharacters")
  banned                                        banned?
  battlepass                                    battlepass?
  business_history                              business_history[]
  character_animation_bind                      character_animation_bind?
  character_bind_cfg                            character_bind_cfg?
  characters                                    characters?               @relation("charactersTocharacters", fields: [wedding_uuid], references: [uuid], onDelete: NoAction, onUpdate: NoAction)
  other_characters                              characters[]              @relation("charactersTocharacters")
  characters_fractions                          characters_fractions?
  customization                                 customization?
  job_skills                                    job_skills?
}

