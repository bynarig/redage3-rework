generator client {
  provider        = "prisma-client-js"
  // Prisma 7 client engine requires a driver adapter at runtime.
  // We wire @prisma/adapter-pg in services/shared/src/prisma-client.ts.
  previewFeatures = ["driverAdapters"]
  output          = "../../services/shared/prisma"
}

// Renders ../ERD.svg every time `pnpm prisma:generate` runs.
// Requires `prisma-erd-generator` + `@mermaid-js/mermaid-cli` (puppeteer-based,
// ~80 MB on first install). To skip ERD rendering locally without removing the
// generator, set DISABLE_ERD_OUTPUT=true in your env.
generator erd {
  provider = "prisma-erd-generator"
  output   = "../ERD.svg"
  theme    = "default"
  // ignoreEnums = false keeps fractions_type, ad_status, etc. in the diagram.
}

// Emits ../schema.dbml so you can paste it into https://dbdiagram.io for an
// editable, drag-and-drop ERD (zoom, rearrange, share, export PDF/PNG).
// Workflow: `pnpm prisma:generate` → copy schema.dbml contents → dbdiagram.io
//   → "Import" → "From DBML" → paste.
generator dbml {
  provider              = "prisma-dbml-generator"
  output                = ".."
  outputName            = "schema.dbml"
  projectName           = "redage_v3"
  projectDatabaseType   = "PostgreSQL"
  includeRelationFields = "true"
}

datasource db {
  provider = "postgresql"
}

model accounts {
  login                      String   @db.VarChar(50)
  email                      String   @db.VarChar(100)
  password                   String   @db.VarChar(256)
  hwid                       String   @db.VarChar(256)
  ip                         String   @db.VarChar(256)
  social_club                String   @db.VarChar(50)
  donut_currency             Int      @default(0)
  vip_lvl                    Int
  vip_date                   DateTime @db.Timestamp(6)
  promo_codes                String   @db.VarChar(256)
  bonus_codes                String
  character1                 Int
  character2                 Int
  character3                 Int
  characters                 String   @default("[-2,-2,-2,-2,-2,-2]") @db.VarChar(100)
  present                    Int      @default(0) @db.SmallInt
  ref_present                Int      @default(0) @db.SmallInt
  case                       String   @default("[0,0,0]") @db.VarChar(100)
  referral_id                Int      @default(0)
  is_subscribed              Int      @default(0) @db.SmallInt
  subscribed_end_time        DateTime @default(now()) @db.Timestamp(6)
  subscribe_time             DateTime @default(now()) @db.Timestamp(6)
  collection_gifts           String   @default("[]") @db.VarChar(500)
  received_award             String   @default("[0,0,0,0,0,0,0,0,1]") @db.VarChar(75)
  received_award_week        Int      @default(0)
  received_award_donate      Int      @default(0)
  Unique                     String   @default("") @db.VarChar(16)
  last_select_character_uuid Int      @default(0)
  exit_date                  DateTime @default(now()) @db.Timestamp(6)
  ga                         String   @default("") @db.VarChar(25)

  @@id([login, email, social_club])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model admin_access {
  command  String @db.VarChar(50)
  is_admin Int    @db.SmallInt
  min_rank Int    @db.SmallInt

  @@ignore
}

model admins {
  uuid          Int        @id
  admin_lvl     Int        @default(0)
  admin_log     Boolean    @default(false)
  error_log     Boolean    @default(false)
  win_log       Boolean    @default(false)
  agm           Boolean    @default(false)
  kl            Boolean    @default(false)
  hide_nickname Boolean    @default(false)
  hide_me       Boolean    @default(false)
  red_name      Boolean    @default(true)
  esp           Boolean    @default(false)
  is_invisible  Boolean    @default(false)
  characters    characters @relation(fields: [uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction)
}

model advertises {
  advertises_id                                 Int         @id @default(autoincrement())
  author_uuid                                   Int?
  author_sim                                    Int?
  ad                                            String      @db.VarChar(150)
  link                                          String      @default("") @db.VarChar(150)
  editor_uuid                                   Int?
  edited_ad                                     String?     @db.VarChar(500)
  opened_at                                     DateTime    @db.Timestamp(6)
  closed_at                                     DateTime    @db.Timestamp(6)
  ad_status                                     ad_status   @default(OPENED)
  ad_type                                       ad_type     @default(NEWS)
  is_premium                                    Boolean     @default(false)
  characters_advertises_author_simTocharacters  characters? @relation("advertises_author_simTocharacters", fields: [author_sim], references: [sim_card], onDelete: NoAction, onUpdate: NoAction)
  characters_advertises_author_uuidTocharacters characters? @relation("advertises_author_uuidTocharacters", fields: [author_uuid], references: [uuid], onDelete: NoAction, onUpdate: NoAction)
  characters_advertises_editor_uuidTocharacters characters? @relation("advertises_editor_uuidTocharacters", fields: [editor_uuid], references: [uuid], onDelete: NoAction, onUpdate: NoAction)
}

model alco_clubs {
  alco_club_id Int  @id @default(0)
  alco1        Int? @default(0)
  alco2        Int? @default(0)
  alco3        Int? @default(0)
