  characters        characters @relation(fields: [uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model bonus_codes {
  code        String? @default("changeit") @db.VarChar(50)
  used_times  BigInt? @default(0)
  usage_limit BigInt? @default(0)
  msg_r       String? @default("Вы успешно активировали бонус код!") @db.VarChar(400)
  exp_r       Int?    @default(0) @db.SmallInt
  money_r     Int?    @default(0)
  vip_r       Int?    @default(0) @db.SmallInt
  vipdays_r   Int?    @default(0) @db.SmallInt
  itemsm_r    String? @default("[]") @db.VarChar(4096)
  itemsf_r    String? @default("[]") @db.VarChar(4096)

  @@ignore
}

model business_history {
  business_id Int         @id
  date        DateTime    @default(now()) @db.Timestamp(6)
  uuid        Int?
  item        String      @default("") @db.VarChar(50)
  price       Int         @default(0)
  businesses  businesses  @relation(fields: [business_id], references: [business_id], onDelete: Cascade, onUpdate: NoAction)
  characters  characters? @relation(fields: [uuid], references: [uuid], onDelete: NoAction, onUpdate: NoAction)
}

model businesses {
  business_id      Int               @id
  owner            String            @default("GOVERNMENT") @db.VarChar(256)
  name             String?           @db.VarChar(256)
  description      String?           @db.VarChar(256)
  sell_price       Int
  type             Int
  products         String
  enter_point      String            @db.VarChar(256)
  unload_point     String            @db.VarChar(256)
  money            Int
  mafia            Int
  orders           String
  tax              Float?            @default(0.013)
  business_history business_history?
}

model character_animation_bind {
