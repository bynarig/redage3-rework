# Shared env for all server-side JS processes (gateway + services).
# Copy to .env at the repo root or per-package and adjust.

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=redage-dev

# --- Database (Prisma) ---
DATABASE_URL=postgresql://redage:redage@localhost:5432/redage?schema=public

# --- Observability ---
LOG_LEVEL=info
NODE_ENV=development
PRISMA_LOG=0

# --- Gateway ---
GATEWAY_REPLY_TOPIC=game.replies.gateway
GATEWAY_CONSUMER_GROUP=redage-gateway
POSITION_THROTTLE_MS=1000

# --- Service-specific consumer groups (override only if scaling out) ---
AUTH_CONSUMER_GROUP=redage-auth-service
PLAYER_CONSUMER_GROUP=redage-player-service

# --- Health probe (0 = disabled) ---
HEALTH_PORT=0
