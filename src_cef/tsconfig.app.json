{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "auto-imports.d.ts"],
  "exclude": ["src/**/__tests__/*", "src/views/dev/**/*"],
  "compilerOptions": {
    // RAGE MP CEF runs on Chrome ~80. Restrict TypeScript's type library to ES2020
    // so that ES2021+ APIs (Array.at, Object.hasOwn, String.replaceAll, Promise.any,
    // WeakRef, FinalizationRegistry, structuredClone) produce type errors instead of
    // silently compiling to broken runtime calls.
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    // Extra safety for array and object lookups, but may have false positives.
    "noUncheckedIndexedAccess": true,

    // Path mapping for cleaner imports.
	  "paths": {
		  "@/*": [
			  "./src/*"
		  ],
		  "api": [
			  "./src/api"
		  ],
		  "api/*": [
			  "./src/api/*"
		  ],
		  "lang": [
			  "./src/lang"
		  ],
		  "lang/*": [
			  "./src/lang/*"
		  ]
	  },
	  "strict": true,
    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
